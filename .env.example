# Copy to .env and fill in. Never commit .env (rule 9).

# --- Teacher / judge: one model for the whole project (rule 8) ---
# Any OpenAI-compatible endpoint works; `core/llm.py` cannot tell them apart.
#
# DEFAULT: local and free. Run `ollama serve` on a GPU laptop:
#     ollama pull qwen2.5:7b
VERIMEM_API_BASE_URL=http://localhost:11434/v1
VERIMEM_API_KEY=ollama
VERIMEM_API_MODEL=qwen2.5:7b
#
# Hosted alternatives, if the P2.3 pilot says local quality is not good enough:
#   OpenRouter    https://openrouter.ai/api/v1   qwen/qwen-2.5-72b-instruct
#   Model Studio  https://dashscope-intl.aliyuncs.com/compatible-mode/v1   qwen-flash
# Switching is these three lines and nothing else. The cache keys include the
# provider, so the two never share cached answers.
# Rule 8: judge calls run with thinking off. Qwen3 on Model Studio takes
# extra_body={"enable_thinking": false}; OpenRouter takes reasoning={"enabled": false}.
VERIMEM_DISABLE_THINKING=1
# Hard spend cap in USD, set in P0.6. The cost tracker refuses calls past this.
VERIMEM_API_SPEND_CAP_USD=

# --- Web search (P0.7). Fill whichever provider you picked. ---
TAVILY_API_KEY=
SERPER_API_KEY=
VERIMEM_SEARCH_PROVIDER=tavily

# --- Optional logging ---
WANDB_API_KEY=
WANDB_PROJECT=verimem

# --- Paths (optional overrides; defaults are repo-relative) ---
# VERIMEM_CACHE_DIR=
# VERIMEM_DATA_DIR=
# VERIMEM_RESULTS_DIR=
